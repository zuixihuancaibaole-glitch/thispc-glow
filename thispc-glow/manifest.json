{
  "manifestVersion": 5,
  "id": "com.local.thispc.glow",
  "name": "这台电脑的插件",
  "version": "1.5.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "thispcGlowPanel",
      "label": {
        "default": "这台电脑的插件"
      },
      "minimumSize": {
        "width": 320,
        "height": 500
      },
      "maximumSize": {
        "width": 720,
        "height": 1100
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 710
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 710
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "assets/icons/panel-brand.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "assets/icons/plugin-brand.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "launchProcess": {
      "schemes": [
        "https"
      ]
    }
  }
}
